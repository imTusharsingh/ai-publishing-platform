# API
PORT=3008
CORS_ORIGIN=http://localhost:3006,http://localhost:3007
NEXT_PUBLIC_API_URL=http://localhost:3008

# Database (Sprint 1+)
DATABASE_URL=postgresql://postgres:postgres@localhost:3009/ai_publishing

# Redis (Sprint 9+)
REDIS_URL=redis://localhost:3010
ENABLE_BULL_BOARD=true

# Auth (Sprint 2+)
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI (Sprint 13+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.35
OPENAI_MAX_COMPLETION_TOKENS=10000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# mock | openai — defaults to openai when OPENAI_API_KEY is set, otherwise mock
AI_WRITER_PROVIDER=
AI_EMBEDDING_PROVIDER=
# mock | openai — quality gate provider; defaults to openai when OPENAI_API_KEY is set
AI_QUALITY_PROVIDER=
AI_SEO_PROVIDER=
# mock | openai — featured image provider; defaults to openai when OPENAI_API_KEY is set
AI_IMAGE_PROVIDER=
OPENAI_IMAGE_MODEL=dall-e-3
# Directory for generated article hero images (defaults to apps/web/public/media/articles)
ARTICLE_MEDIA_DIR=
# Optional S3 media storage. When ARTICLE_MEDIA_S3_BUCKET is set, generated
# article hero and inline images are uploaded to S3 instead of local disk.
ARTICLE_MEDIA_S3_BUCKET=
ARTICLE_MEDIA_S3_PREFIX=media/articles
ARTICLE_MEDIA_PUBLIC_BASE_URL=
# Public site URL for canonical links and sitemap (defaults to first CORS origin)
PUBLIC_SITE_URL=
# Quality gate thresholds (0-1 for scores) — writer prompts align to these defaults
QUALITY_MIN_GRAMMAR=0.7
QUALITY_MIN_READABILITY=0.55
QUALITY_MAX_SPAM=0.4
QUALITY_MIN_WORDS=3000

# Trend discovery (Sprint 15+)
# auto | live | mock | openai
# auto: OpenAI-synthesized unique topics when OPENAI_API_KEY is set, else live feeds, else mock
# openai: always use OpenAI (uses live feeds as optional signals when available)
TREND_DISCOVERY_PROVIDER=auto
TREND_DISCOVERY_MAX_TOPICS=12
NEWS_API_KEY=

# Seed (Sprint 1+)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
