# API
PORT=3008
CORS_ORIGIN=http://localhost:3006,http://localhost:3007
NEXT_PUBLIC_API_URL=http://localhost:3008

# Database (Sprint 1+)
DATABASE_URL=postgresql://postgres:postgres@localhost:3009/ai_publishing

# Redis (Sprint 9+)
REDIS_URL=redis://localhost:3010
ENABLE_BULL_BOARD=true

# Auth (Sprint 2+)
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI (Sprint 13+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# mock | openai — defaults to openai when OPENAI_API_KEY is set, otherwise mock
AI_WRITER_PROVIDER=

# Seed (Sprint 1+)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
